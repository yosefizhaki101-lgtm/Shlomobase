{
  "name": "TombstonePart",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "headstone",
        "slab",
        "frame",
        "base"
      ],
      "default": "base"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "geom": {
      "type": "string"
    },
    "height": {
      "type": "number"
    },
    "override_color": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category",
    "name",
    "geom"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}